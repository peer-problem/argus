{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/argus-run.schema.json",
  "title": "ARGUS normalized run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "source",
    "track",
    "dataset",
    "status",
    "score",
    "finalAnswer",
    "outcome",
    "failure",
    "caps",
    "totals",
    "hashes",
    "compliance",
    "events",
    "importedAt"
  ],
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "portalRunId": { "type": ["string", "null"] },
    "source": { "enum": ["portal", "aigo", "merged", "demo"] },
    "track": { "enum": ["coding", "math", "generic", "unknown"] },
    "dataset": { "type": "string" },
    "itemId": { "type": ["string", "null"] },
    "status": { "enum": ["queued", "running", "completed", "failed", "capped", "unknown"] },
    "score": { "type": ["number", "null"] },
    "finalAnswer": { "type": ["string", "null"] },
    "outcome": {
      "enum": ["graded", "extraction_failed", "capped", "grader_error", "infrastructure_failed", "unknown"]
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["itemStatus", "kind", "owner", "secondaryTags", "message"],
      "properties": {
        "itemStatus": { "enum": ["ok", "capped_tokens", "capped_wallclock", "error", "unknown"] },
        "kind": { "enum": ["infrastructure", "upstream_error", "token_cap", "wallclock_cap", "runner", "unknown"] },
        "owner": { "enum": ["team", "policy", "configuration", "organizer", "unknown"] },
        "secondaryTags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "message": { "type": "string" }
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runTokens", "itemWallclockSeconds", "usedTokens", "elapsedMs"],
      "properties": {
        "runTokens": { "type": ["number", "null"], "minimum": 0 },
        "itemWallclockSeconds": { "type": ["number", "null"], "minimum": 0 },
        "usedTokens": { "type": "number", "minimum": 0 },
        "elapsedMs": { "type": "number", "minimum": 0 }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "reasoning", "cachedInput", "normalizedCost", "latencyMs"],
      "properties": {
        "input": { "type": "number", "minimum": 0 },
        "output": { "type": "number", "minimum": 0 },
        "reasoning": { "type": "number", "minimum": 0 },
        "cachedInput": { "type": "number", "minimum": 0 },
        "normalizedCost": { "type": "number", "minimum": 0 },
        "latencyMs": { "type": "number", "minimum": 0 }
      }
    },
    "modelUsage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "calls", "input", "output", "reasoning", "cachedInput", "normalizedCost", "latencyMs"],
        "properties": {
          "model": { "type": "string" },
          "calls": { "type": "integer", "minimum": 0 },
          "input": { "type": "number", "minimum": 0 },
          "output": { "type": "number", "minimum": 0 },
          "reasoning": { "type": "number", "minimum": 0 },
          "cachedInput": { "type": "number", "minimum": 0 },
          "normalizedCost": { "type": "number", "minimum": 0 },
          "latencyMs": { "type": "number", "minimum": 0 }
        }
      }
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "squadConfig", "submissionJson", "prompt"],
      "properties": {
        "dataset": { "type": ["string", "null"] },
        "squadConfig": { "type": ["string", "null"] },
        "submissionJson": { "type": ["string", "null"] },
        "prompt": { "type": ["string", "null"] }
      }
    },
    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userToolsZero", "plannerNativeProtocol", "memoryOff", "hashesPresent", "outputContract", "fallbackFree"],
      "properties": {
        "userToolsZero": { "type": ["boolean", "null"] },
        "plannerNativeProtocol": { "type": ["boolean", "null"] },
        "memoryOff": { "type": ["boolean", "null"] },
        "hashesPresent": { "type": ["boolean", "null"] },
        "outputContract": { "type": ["boolean", "null"] },
        "fallbackFree": { "type": ["boolean", "null"] }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "https://argus.local/schemas/argus-event.schema.json" }
    },
    "rawEvidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "importedAt": { "type": "string", "format": "date-time" }
  }
}
