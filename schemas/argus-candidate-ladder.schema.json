{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/argus-candidate-ladder.schema.json",
  "title": "ARGUS plan-only candidate ladder",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "evidenceMode",
    "authoritativeBaseline",
    "evaluationSettingsOverridesReachRuntime",
    "sharedInvariants",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capturedAt": { "type": "string", "format": "date-time" },
    "evidenceMode": { "const": "plan-only" },
    "authoritativeBaseline": { "const": "ARGUS-C0" },
    "evaluationSettingsOverridesReachRuntime": { "const": false },
    "sharedInvariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["userTools", "memoryEnabled", "executionMode", "contextPager", "externalExecution"],
      "properties": {
        "userTools": { "const": 0 },
        "memoryEnabled": { "const": false },
        "executionMode": { "const": "in-process" },
        "contextPager": { "const": "experimental-only" },
        "externalExecution": { "const": false }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "purpose",
          "baseCandidate",
          "architectureVariants",
          "plannerModels",
          "solverModels",
          "reviewerModel",
          "routePolicy",
          "dynamicRoutingImplemented",
          "promotionGates"
        ],
        "properties": {
          "id": { "enum": ["ARGUS-G0", "ARGUS-C0", "ARGUS-C1", "ARGUS-C2", "ARGUS-C3"] },
          "status": { "enum": ["planned", "testing"] },
          "purpose": { "type": "string", "minLength": 1 },
          "baseCandidate": {
            "oneOf": [
              { "type": "null" },
              { "enum": ["ARGUS-C0", "ARGUS-C1", "ARGUS-C2"] }
            ]
          },
          "architectureVariants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["A1", "A2", "A3", "AF"] }
          },
          "plannerModels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "furiosa-ai/Qwen3-32B-FP8",
                "furiosa-ai/K-EXAONE-236B-A23B-NVFP4A16"
              ]
            }
          },
          "solverModels": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "furiosa-ai/Qwen3-32B-FP8",
                "furiosa-ai/gpt-oss-120b",
                "furiosa-ai/K-EXAONE-236B-A23B-NVFP4A16"
              ]
            }
          },
          "reviewerModel": {
            "oneOf": [
              { "type": "null" },
              {
                "enum": [
                  "furiosa-ai/Qwen3-32B-FP8",
                  "furiosa-ai/gpt-oss-120b",
                  "furiosa-ai/K-EXAONE-236B-A23B-NVFP4A16"
                ]
              }
            ]
          },
          "routePolicy": {
            "enum": [
              "architecture-gate",
              "fixed",
              "evidence-gated-cost-adaptive",
              "reviewer-evidence-gated",
              "planner-upgrade-only"
            ]
          },
          "dynamicRoutingImplemented": { "const": false },
          "promotionGates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          }
        }
      }
    }
  }
}
